<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="18dp"
    app:strokeColor="@color/item_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="18dp">

        <TextView
            android:id="@+id/armor_type"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_armor_type_chip"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.MhwCompanion.Title"
            android:textColor="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/armor_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.MhwCompanion.Title"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/armor_rank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.MhwCompanion.Body"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/armor_skills"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.MhwCompanion.Caption"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/armor_slots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_rarity_pill"
                android:paddingLeft="10dp"
                android:paddingTop="4dp"
                android:paddingRight="10dp"
                android:paddingBottom="4dp"
                android:textAppearance="@style/TextAppearance.MhwCompanion.Caption"
                android:textColor="@color/primary_amber_dark" />
        </LinearLayout>

        <TextView
            android:id="@+id/armor_rarity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rarity_pill"
            android:paddingLeft="12dp"
            android:paddingTop="6dp"
            android:paddingRight="12dp"
            android:paddingBottom="6dp"
            android:textAppearance="@style/TextAppearance.MhwCompanion.Body"
            android:textColor="@color/primary_amber_dark" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>