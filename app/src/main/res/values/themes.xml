<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MhwCompanion" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary_amber</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="colorSurface">@color/surface_base</item>
        <item name="android:windowBackground">@color/surface_base</item>
    </style>

    <style name="TextAppearance.MhwCompanion.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.MhwCompanion.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.MhwCompanion.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.MhwCompanion.Caption" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
</resources>
